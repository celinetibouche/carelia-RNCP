<mxfile host="app.diagrams.net">
  <diagram id="cas-utilisation-absences" name="Cas d'utilisation - Absences">
    <mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Cadre du système -->
        <mxCell id="sys" value="Carelia : Absences" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=14;fillColor=#fbf8f4;strokeColor=#765747;" vertex="1" parent="1">
          <mxGeometry x="220" y="20" width="560" height="620" as="geometry" />
        </mxCell>

        <!-- Acteurs -->
        <mxCell id="parent" value="Parent" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="250" width="40" height="80" as="geometry" />
        </mxCell>
        <mxCell id="equipe" value="Équipe&lt;br&gt;(EJE, auxiliaire)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="860" y="200" width="40" height="80" as="geometry" />
        </mxCell>
        <mxCell id="direction" value="Direction" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="980" y="360" width="40" height="80" as="geometry" />
        </mxCell>

        <!-- Cas d'utilisation (ovales) -->
        <mxCell id="uc2" value="Consulter les absences à venir&lt;br&gt;(US2)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f4eee5;strokeColor=#765747;" vertex="1" parent="1">
          <mxGeometry x="250" y="70" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="uc3" value="Annuler une absence&lt;br&gt;(US3)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f4eee5;strokeColor=#765747;" vertex="1" parent="1">
          <mxGeometry x="250" y="170" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="uc4" value="Modifier la date de fin&lt;br&gt;(US4)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f4eee5;strokeColor=#765747;" vertex="1" parent="1">
          <mxGeometry x="250" y="270" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="uc1" value="Déclarer une absence&lt;br&gt;(US1, US6)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f4eee5;strokeColor=#765747;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="400" y="430" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="ucr" value="Contrôler les règles métier&lt;br&gt;(RG3 à RG10)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#765747;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="400" y="550" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="uc5" value="Voir les absents du jour&lt;br&gt;(US5)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f4eee5;strokeColor=#765747;" vertex="1" parent="1">
          <mxGeometry x="560" y="70" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="uc7" value="Enregistrer un justificatif reçu&lt;br&gt;(US7)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f4eee5;strokeColor=#765747;" vertex="1" parent="1">
          <mxGeometry x="560" y="170" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="uc8" value="Gérer les absences d'un enfant&lt;br&gt;(US8)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f4eee5;strokeColor=#765747;" vertex="1" parent="1">
          <mxGeometry x="560" y="270" width="200" height="70" as="geometry" />
        </mxCell>

        <!-- Associations acteur - cas (traits simples) -->
        <mxCell id="a1" style="endArrow=none;html=1;" edge="1" parent="1" source="parent" target="uc2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a2" style="endArrow=none;html=1;" edge="1" parent="1" source="parent" target="uc3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a3" style="endArrow=none;html=1;" edge="1" parent="1" source="parent" target="uc4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a4" style="endArrow=none;html=1;" edge="1" parent="1" source="parent" target="uc1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a5" style="endArrow=none;html=1;" edge="1" parent="1" source="equipe" target="uc5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a6" style="endArrow=none;html=1;" edge="1" parent="1" source="equipe" target="uc7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a7" style="endArrow=none;html=1;" edge="1" parent="1" source="equipe" target="uc8"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a8" style="endArrow=none;html=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="equipe" target="uc1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="805" y="240" /><mxPoint x="805" y="465" /></Array></mxGeometry></mxCell>

        <!-- Héritage : la direction est un membre de l'équipe (flèche à triangle vide) -->
        <mxCell id="g1" style="endArrow=block;endFill=0;endSize=14;html=1;exitX=0.5;exitY=0;entryX=1;entryY=0.5;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="direction" target="equipe"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Inclusions (pointillés, «include») -->
        <mxCell id="i1" value="«include»" style="endArrow=open;dashed=1;html=1;fontSize=11;" edge="1" parent="1" source="uc1" target="ucr"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="i2" value="«include»" style="endArrow=open;dashed=1;html=1;fontSize=11;exitX=0;exitY=0.5;entryX=0;entryY=0.7;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="uc3" target="ucr"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="235" y="205" /><mxPoint x="235" y="599" /></Array></mxGeometry></mxCell>
        <mxCell id="i3" value="«include»" style="endArrow=open;dashed=1;html=1;fontSize=11;exitX=0.4;exitY=1;entryX=0;entryY=0.3;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="uc4" target="ucr"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="330" y="571" /></Array></mxGeometry></mxCell>
        <mxCell id="i4" value="«include»" style="endArrow=open;dashed=1;html=1;fontSize=11;" edge="1" parent="1" source="uc8" target="uc3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="i5" value="«include»" style="endArrow=open;dashed=1;html=1;fontSize=11;" edge="1" parent="1" source="uc8" target="uc4"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
